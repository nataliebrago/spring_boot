<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Archetype Created Web Application</display-name>

  <servlet>
    <servlet-name>hello-serv</servlet-name>
    <servlet-class>HelloServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>washington-serv</servlet-name>
    <servlet-class>WashingtonTimeServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>age-serv</servlet-name>
    <servlet-class>AgeServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>hello-serv</servlet-name>
    <url-pattern>/hello-page</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>washington-serv</servlet-name>
    <url-pattern>/washington</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>age-serv</servlet-name>
    <url-pattern>/checkAge</url-pattern>
  </servlet-mapping>
</web-app>
